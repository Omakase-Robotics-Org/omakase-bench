<?xml version="1.0"?>
<!-- arm6: a six-joint arm on a pedestal with a parallel gripper, built from boxes only.
     Written for omakase-bench as a second robot description; it models no product. -->
<robot name="arm6">
  <link name="base_footprint" />
  <link name="pedestal">
    <inertial><origin xyz="0 0 0.45" rpy="0 0 0" /><mass value="40" /><inertia ixx="2.833333" iyy="2.833333" izz="0.266667" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0 0 0.45" rpy="0 0 0" /><geometry><box size="0.2 0.2 0.9" /></geometry><material name="pedestal_colour"><color rgba="0.2 0.2 0.22 1" /></material></visual>
    <collision><origin xyz="0 0 0.45" rpy="0 0 0" /><geometry><box size="0.2 0.2 0.9" /></geometry></collision>
  </link>
  <joint name="pedestal_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="pedestal" />
  </joint>
  <link name="shoulder_link">
    <inertial><origin xyz="0 0 0.04" rpy="0 0 0" /><mass value="2" /><inertia ixx="0.002733" iyy="0.002733" izz="0.003333" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0 0 0.04" rpy="0 0 0" /><geometry><box size="0.1 0.1 0.08" /></geometry><material name="shoulder_link_colour"><color rgba="0.75 0.75 0.78 1" /></material></visual>
    <collision><origin xyz="0 0 0.04" rpy="0 0 0" /><geometry><box size="0.1 0.1 0.08" /></geometry></collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.90" rpy="0 0 0" />
    <parent link="pedestal" />
    <child link="shoulder_link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.9" upper="2.9" effort="80" velocity="2" />
  </joint>
  <link name="upper_arm_link">
    <inertial><origin xyz="0.175 0 0" rpy="0 0 0" /><mass value="2" /><inertia ixx="0.001633" iyy="0.021233" izz="0.021233" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0.175 0 0" rpy="0 0 0" /><geometry><box size="0.35 0.07 0.07" /></geometry><material name="upper_arm_link_colour"><color rgba="0.95 0.5 0.1 1" /></material></visual>
    <collision><origin xyz="0.175 0 0" rpy="0 0 0" /><geometry><box size="0.35 0.07 0.07" /></geometry></collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0.08" rpy="0 0 0" />
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <axis xyz="0 1 0" />
    <limit lower="-2.6" upper="1" effort="80" velocity="2" />
  </joint>
  <link name="forearm_link">
    <inertial><origin xyz="0.085 0 0" rpy="0 0 0" /><mass value="1" /><inertia ixx="0.000600" iyy="0.002708" izz="0.002708" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0.085 0 0" rpy="0 0 0" /><geometry><box size="0.17 0.06 0.06" /></geometry><material name="forearm_link_colour"><color rgba="0.75 0.75 0.78 1" /></material></visual>
    <collision><origin xyz="0.085 0 0" rpy="0 0 0" /><geometry><box size="0.17 0.06 0.06" /></geometry></collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="0.35 0 0" rpy="0 0 0" />
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <axis xyz="0 1 0" />
    <limit lower="-0.3" upper="2.7" effort="60" velocity="2" />
  </joint>
  <link name="wrist_roll_link">
    <inertial><origin xyz="0.08 0 0" rpy="0 0 0" /><mass value="0.8" /><inertia ixx="0.000403" iyy="0.001908" izz="0.001908" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0.08 0 0" rpy="0 0 0" /><geometry><box size="0.16 0.055 0.055" /></geometry><material name="wrist_roll_link_colour"><color rgba="0.95 0.5 0.1 1" /></material></visual>
    <collision><origin xyz="0.08 0 0" rpy="0 0 0" /><geometry><box size="0.16 0.055 0.055" /></geometry></collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="0.17 0 0" rpy="0 0 0" />
    <parent link="forearm_link" />
    <child link="wrist_roll_link" />
    <axis xyz="1 0 0" />
    <limit lower="-3" upper="3" effort="30" velocity="3" />
  </joint>
  <link name="wrist_pitch_link">
    <inertial><origin xyz="0.035 0 0" rpy="0 0 0" /><mass value="0.4" /><inertia ixx="0.000167" iyy="0.000247" izz="0.000247" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0.035 0 0" rpy="0 0 0" /><geometry><box size="0.07 0.05 0.05" /></geometry><material name="wrist_pitch_link_colour"><color rgba="0.75 0.75 0.78 1" /></material></visual>
    <collision><origin xyz="0.035 0 0" rpy="0 0 0" /><geometry><box size="0.07 0.05 0.05" /></geometry></collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0.16 0 0" rpy="0 0 0" />
    <parent link="wrist_roll_link" />
    <child link="wrist_pitch_link" />
    <axis xyz="0 1 0" />
    <limit lower="-2" upper="2" effort="30" velocity="3" />
  </joint>
  <link name="tool_link">
    <inertial><origin xyz="0.02 0 0" rpy="0 0 0" /><mass value="0.3" /><inertia ixx="0.000342" iyy="0.000080" izz="0.000342" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0.02 0 0" rpy="0 0 0" /><geometry><box size="0.04 0.11 0.04" /></geometry><material name="tool_link_colour"><color rgba="0.2 0.2 0.22 1" /></material></visual>
    <collision><origin xyz="0.02 0 0" rpy="0 0 0" /><geometry><box size="0.04 0.11 0.04" /></geometry></collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0.07 0 0" rpy="0 0 0" />
    <parent link="wrist_pitch_link" />
    <child link="tool_link" />
    <axis xyz="1 0 0" />
    <limit lower="-3" upper="3" effort="20" velocity="3" />
  </joint>
  <link name="finger_l_link">
    <inertial><origin xyz="0.03 0 0" rpy="0 0 0" /><mass value="0.05" /><inertia ixx="0.000002" iyy="0.000017" izz="0.000016" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0.03 0 0" rpy="0 0 0" /><geometry><box size="0.06 0.012 0.02" /></geometry><material name="finger_l_link_colour"><color rgba="0.75 0.75 0.78 1" /></material></visual>
    <collision><origin xyz="0.03 0 0" rpy="0 0 0" /><geometry><box size="0.06 0.012 0.02" /></geometry></collision>
  </link>
  <joint name="finger_l_joint" type="prismatic">
    <origin xyz="0.04 0.046 0" rpy="0 0 0" />
    <parent link="tool_link" />
    <child link="finger_l_link" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.04" effort="60" velocity="0.1" />
  </joint>
  <link name="finger_r_link">
    <inertial><origin xyz="0.03 0 0" rpy="0 0 0" /><mass value="0.05" /><inertia ixx="0.000002" iyy="0.000017" izz="0.000016" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0.03 0 0" rpy="0 0 0" /><geometry><box size="0.06 0.012 0.02" /></geometry><material name="finger_r_link_colour"><color rgba="0.75 0.75 0.78 1" /></material></visual>
    <collision><origin xyz="0.03 0 0" rpy="0 0 0" /><geometry><box size="0.06 0.012 0.02" /></geometry></collision>
  </link>
  <joint name="finger_r_joint" type="prismatic">
    <origin xyz="0.04 -0.046 0" rpy="0 0 0" />
    <parent link="tool_link" />
    <child link="finger_r_link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.04" effort="60" velocity="0.1" />
  </joint>
  <link name="tcp" />
  <joint name="tcp_joint" type="fixed">
    <origin xyz="0.09 0 0" rpy="0 0 0" />
    <parent link="tool_link" />
    <child link="tcp" />
  </joint>
  <link name="mast">
    <inertial><origin xyz="0 0 0.325" rpy="0 0 0" /><mass value="1" /><inertia ixx="0.035283" iyy="0.035283" izz="0.000150" ixy="0" ixz="0" iyz="0" /></inertial>
    <visual><origin xyz="0 0 0.325" rpy="0 0 0" /><geometry><box size="0.03 0.03 0.65" /></geometry><material name="mast_colour"><color rgba="0.2 0.2 0.22 1" /></material></visual>
    <collision><origin xyz="0 0 0.325" rpy="0 0 0" /><geometry><box size="0.03 0.03 0.65" /></geometry></collision>
  </link>
  <joint name="mast_joint" type="fixed">
    <origin xyz="-0.085 0 0.90" rpy="0 0 0" />
    <parent link="pedestal" />
    <child link="mast" />
  </joint>
  <link name="head_camera_optical" />
  <joint name="head_camera_joint" type="fixed">
    <origin xyz="-0.02 0 1.55" rpy="-2.59357 -0.00000 -1.57080" />
    <parent link="base_footprint" />
    <child link="head_camera_optical" />
  </joint>
  <link name="wrist_camera_optical" />
  <joint name="wrist_camera_joint" type="fixed">
    <origin xyz="0.0 0 0.045" rpy="-1.57080 -0.00000 -1.57080" />
    <parent link="tool_link" />
    <child link="wrist_camera_optical" />
  </joint>
</robot>
